{
	"name": "relay-nextjs",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"generate": "bunx tsx scripts/generate-workflows.ts",
		"dev": "concurrently \"bun run scripts/generate-workflows.ts --watch\" \"next dev\"",
		"build": "bunx tsx scripts/generate-workflows.ts && next build",
		"start": "next start",
		"format": "biome format --write",
		"lint": "biome lint --fix"
	},
	"dependencies": {
		"next": "16.0.6",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"workflow": "^4.0.1-beta.24",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"concurrently": "^9.1.2",
		"eslint": "^9",
		"eslint-config-next": "16.0.6",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
